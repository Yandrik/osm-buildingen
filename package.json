{
  "name": "osm-buildingen",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "test": "vitest run && pnpm -r --if-present test",
    "test:watch": "vitest",
    "typecheck": "tsc -b && pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "studio": "pnpm --filter @osm-buildingen/studio dev",
    "viewer": "pnpm --filter @osm-buildingen/viewer dev",
    "golden:update": "UPDATE_GOLDEN=1 vitest run packages/core/test/golden"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
