  "private": true,
  "description": "Cell-shaded bike / car / plane sim over real terrain and OSM buildings (Paris area)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepare-site": "tsx scripts/prepare-site.ts",
