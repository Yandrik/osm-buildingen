    "@osm-buildingen/osm": "workspace:*",
    "@osm-buildingen/three": "workspace:*",
    "pmtiles": "^4.3.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.170.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.21"
  }
}
