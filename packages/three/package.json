{
  "name": "@osm-buildingen/three",
  "version": "0.1.0",
  "description": "three.js adapter for @osm-buildingen/core",
  "license": "MIT",
  "author": "Yandrik",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yandrik/osm-buildingen.git",
    "directory": "packages/three"
  },
  "homepage": "https://github.com/Yandrik/osm-buildingen#readme",
  "bugs": "https://github.com/Yandrik/osm-buildingen/issues",
  "keywords": ["three", "threejs", "procedural", "building", "low-poly", "web-worker"],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts src/worker.ts --format esm --dts --clean --target es2022 --sourcemap",
    "prepack": "pnpm run build && cp ../../LICENSE LICENSE"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./worker": {
        "types": "./dist/worker.d.ts",
        "import": "./dist/worker.js"
      }
    }
  },
  "dependencies": {
    "@osm-buildingen/core": "workspace:*"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "three": "^0.170.0"
  }
}
